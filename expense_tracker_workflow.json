{
  "name": "Expense Tracker - Foto Scontrino → Sheets",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-128, -32],
      "id": "1ff6cc73-bc36-4f1f-9439-03474ad554e6",
      "name": "Telegram Trigger",
      "webhookId": "20b9e3bf-e413-4fb1-8c3f-9dd663327484",
      "credentials": {
        "telegramApi": {
          "id": "eFpAnLP1Wp843374",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond_has_photo",
              "leftValue": "={{ $json.message.photo }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [100, -32],
      "id": "check-photo-node",
      "name": "Ha una foto?"
    },
    {
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.message.photo[$json.message.photo.length - 1].file_id }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [320, -120],
      "id": "88b4ae77-9a47-48b8-b63d-84e45d92d9e8",
      "name": "Get a file",
      "credentials": {
        "telegramApi": {
          "id": "eFpAnLP1Wp843374",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/file/bot{{ $credentials.accessToken }}/{{ $json.result.file_path }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "telegramApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, -120],
      "id": "download-image-node",
      "name": "Download Immagine",
      "credentials": {
        "telegramApi": {
          "id": "eFpAnLP1Wp843374",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "google/gemini-flash-1.5",
          "max_tokens": 500,
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "Analizza questo scontrino e restituisci SOLO un JSON con questi campi:\n{\n  \"data\": \"GG/MM/AAAA\",\n  \"fornitore\": \"nome negozio\",\n  \"categoria\": \"una di: Pasto, Trasporto, Carburante, Supermercato, Ufficio, Salute, Intrattenimento, Altro\",\n  \"importo\": 0.00,\n  \"note\": \"dettagli facoltativi\",\n  \"errore\": null\n}\nSe non riesci a leggere importo o fornitore, metti errore con spiegazione. Niente markdown, solo JSON."
                },
                {
                  "type": "image_url",
                  "image_url": {
                    "url": "=data:image/jpeg;base64,{{ $binary.data.data }}"
                  }
                }
              ]
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, -120],
      "id": "ai-vision-node",
      "name": "AI Vision - Analizza Scontrino",
      "credentials": {
        "httpHeaderAuth": {
          "id": "06S91OrDmDlAsD5X",
          "name": "OpenRouter account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices[0].message.content.trim();\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { errore: 'JSON non valido: ' + raw, data: '', fornitore: '', categoria: '', importo: '', note: '' } }];\n}\n// Normalizza importo\nif (parsed.importo != null && parsed.importo !== '') {\n  parsed.importo = parseFloat(String(parsed.importo).replace(',', '.')).toFixed(2);\n}\n// Usa data di oggi se mancante\nif (!parsed.data) {\n  const d = new Date();\n  parsed.data = `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;\n}\nreturn [{ json: parsed }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, -120],
      "id": "parse-response-node",
      "name": "Parse Risposta AI"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond_no_error",
              "leftValue": "={{ $json.errore }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, -120],
      "id": "check-ai-result-node",
      "name": "AI ha letto lo scontrino?"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "ID_GOOGLE_SHEET",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Data": "={{ $json.data }}",
            "Fornitore": "={{ $json.fornitore }}",
            "Categoria": "={{ $json.categoria }}",
            "Importo": "={{ $json.importo }}",
            "Note": "={{ $json.note }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "Data", "displayName": "Data", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" },
            { "id": "Fornitore", "displayName": "Fornitore", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" },
            { "id": "Categoria", "displayName": "Categoria", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" },
            { "id": "Importo", "displayName": "Importo", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "number" },
            { "id": "Note", "displayName": "Note", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1420, -220],
      "id": "google-sheets-node",
      "name": "Google Sheets - Scrivi Riga",
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "CRED_GSHEETS", "name": "Google Sheets Spese" }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=✅ *Scontrino registrato!*\n\n📅 Data: {{ $('Parse Risposta AI').item.json.data }}\n🏪 Fornitore: {{ $('Parse Risposta AI').item.json.fornitore }}\n🏷️ Categoria: {{ $('Parse Risposta AI').item.json.categoria }}\n💶 Importo: €{{ $('Parse Risposta AI').item.json.importo }}\n📝 Note: {{ $('Parse Risposta AI').item.json.note || '-' }}\n\n_Riga aggiunta al registro spese._",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1640, -220],
